{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Debug radiocontrol module",
            "type": "debugpy",
            "request": "launch",
            "module": "radiocontrol",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: Debug entry point",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/debug_entry.py",
            "args": ["${input:entryPointName}"],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ],
    "inputs": [
        {
            "id": "entryPointName",
            "type": "promptString",
            "description": "Name of the radiocontrol function to run under the debugger (e.g. p5, setCW, Scott)"
        }
    ]
}